function clinical = patient_zoya()
% PATIENT_TEMPLATE
% -----------------------------------------------------------------------
% Unified clinical data input struct for the ASD lumped-parameter model.
%
% Fill in all available measurements for your patient. Leave fields that
% are unavailable as NaN. The validation report will display NaN for those
% rows and exclude them from the RMSE calculation.
%
% The struct has three sub-sections:
%   clinical.common       - demographics and measurements shared by scenarios
%   clinical.pre_surgery  - measurements before ASD closure/intervention
%   clinical.post_surgery - measurements after ASD closure/intervention
%
% Pass this struct together with a scenario flag to main_run:
%   main_run('pre_surgery',  clinical)
%   main_run('post_surgery', clinical)
%
% UNITS: all pressures in mmHg; flows in L/min; resistances in Wood units;
%        volumes in mL; weight in kg; height in cm; BSA in m^2.
%
% ASD SIGN CONVENTION:
%   Positive Q_shunt_Lmin means net left-to-right ASD shunt flow
%   (left atrium to right atrium). Pressure gradients should be recorded as
%   upstream minus downstream for the expected shunt direction.
%
% IMPLEMENTATION NOTE:
%   This template names ASD clinical-input fields. The ASD physics path must
%   consume these fields through params_from_clinical and system_rhs before
%   ASD geometry can affect a simulation.
%
% REFERENCES:
%   [1] Clinical data dictionary: docs/clinical_data_dictionary.md
%
% AUTHOR:   Unified ASD Model
% DATE:     2026-05-28
% VERSION:  1.1
% -----------------------------------------------------------------------

clinical = struct();

%% =====================================================================
%  COMMON - patient demographics, measured for any scenario
%% =====================================================================
clinical.common.age_years  = 7.07;   % [years] patient age at measurement
clinical.common.weight_kg  = 18.2;   % [kg]
clinical.common.height_cm  = 119;   % [cm]
clinical.common.sex        = 0;   % [-] 0=female, 1=male
clinical.common.BSA        = 0.788;   % [m^2] leave NaN to compute by Mosteller
clinical.common.HR         = 90;   % [bpm] resting heart rate

%% =====================================================================
%  PRE-SURGERY - haemodynamics in the presence of an open ASD
%  Source: right-heart catheterisation and echocardiography
%% =====================================================================
pre = struct();

% ---- ASD shunt geometry / severity ------------------------------------
pre.ASD_diameter_mm   = 19.25;   % [mm]     atrial septal defect diameter
pre.ASD_area_mm2      = NaN;   % [mm^2]   defect area if measured/planimetered
pre.ASD_gradient_mmHg = NaN;   % [mmHg]   LA-to-RA pressure gradient
pre.Q_shunt_Lmin      = NaN;   % [L/min]  net ASD shunt flow, positive = left-to-right
pre.QpQs              = NaN;   % [-]      pulmonary-to-systemic flow ratio

% ---- Pulmonary circulation --------------------------------------------
pre.PAP_sys_mmHg      = NaN;   % [mmHg]   systolic PA pressure
pre.PAP_dia_mmHg      = NaN;   % [mmHg]   diastolic PA pressure
pre.PAP_mean_mmHg     = NaN;   % [mmHg]   mean PA pressure
pre.PVR_WU            = NaN;   % [WU]     pulmonary vascular resistance

% ---- Systemic circulation ---------------------------------------------
pre.SAP_sys_mmHg      = NaN;   % [mmHg]   systolic arterial pressure
pre.SAP_dia_mmHg      = NaN;   % [mmHg]   diastolic arterial pressure
pre.SAP_mean_mmHg     = NaN;   % [mmHg]   mean arterial pressure
pre.SVR_WU            = NaN;   % [WU]     systemic vascular resistance

% ---- Atrial pressures -------------------------------------------------
pre.RAP_mean_mmHg     = NaN;   % [mmHg]   right atrial mean pressure
pre.LAP_mean_mmHg     = NaN;   % [mmHg]   left atrial mean pressure or PCWP

% ---- Ventricular filling pressures ------------------------------------
pre.LVEDP_mmHg        = NaN;   % [mmHg]   LV end-diastolic pressure
pre.RVEDP_mmHg        = NaN;   % [mmHg]   RV end-diastolic pressure

% ---- Ventricular volumes and function (echo / MRI) --------------------
pre.LVEDV_mL          = NaN;   % [mL]     LV end-diastolic volume
pre.LVESV_mL          = NaN;   % [mL]     LV end-systolic volume
pre.RVEDV_mL          = NaN;   % [mL]     RV end-diastolic volume
pre.RVESV_mL          = NaN;   % [mL]     RV end-systolic volume
pre.EF                = NaN;   % [-]      LV ejection fraction, fraction not percent
pre.override_IC       = false; % [-]      enable echo-informed chamber tuning

% ---- Cardiac output ---------------------------------------------------
pre.CO_Lmin           = NaN;   % [L/min]  systemic cardiac output, Qs

clinical.pre_surgery = pre;

%% =====================================================================
%  POST-SURGERY - haemodynamics after ASD closure
%  Source: post-operative catheterisation / echocardiography
%% =====================================================================
post = struct();

% ---- Residual shunt ---------------------------------------------------
post.QpQs             = NaN;   % [-]      approximately 1.0 expected
post.Q_shunt_Lmin     = NaN;   % [L/min]  residual ASD shunt, positive = left-to-right

% ---- Pulmonary circulation --------------------------------------------
post.PAP_sys_mmHg     = NaN;   % [mmHg]
post.PAP_dia_mmHg     = NaN;   % [mmHg]
post.PAP_mean_mmHg    = NaN;   % [mmHg]
post.PVR_WU           = NaN;   % [WU]     should be lower than pre-surgery

% ---- Systemic circulation ---------------------------------------------
post.SAP_sys_mmHg     = NaN;   % [mmHg]
post.SAP_dia_mmHg     = NaN;   % [mmHg]
post.MAP_mmHg         = NaN;   % [mmHg]   mean arterial pressure
post.SVR_WU           = NaN;   % [WU]

% ---- Atrial pressures -------------------------------------------------
post.RAP_mean_mmHg    = NaN;   % [mmHg]
post.LAP_mean_mmHg    = NaN;   % [mmHg]

% ---- Ventricular filling pressures ------------------------------------
post.LVEDP_mmHg       = NaN;   % [mmHg]
post.RVEDP_mmHg       = NaN;   % [mmHg]

% ---- Ventricular volumes and function ---------------------------------
post.LVEDV_mL         = NaN;   % [mL]
post.LVESV_mL         = NaN;   % [mL]
post.RVEDV_mL         = NaN;   % [mL]
post.RVESV_mL         = NaN;   % [mL]
post.EF               = NaN;   % [-]      LV ejection fraction
post.RVEF             = NaN;   % [-]      RV ejection fraction

% ---- Cardiac output ---------------------------------------------------
post.CO_Lmin          = NaN;   % [L/min]

clinical.post_surgery = post;

end
